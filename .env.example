# Variables que usa pipeline/kynari-publisher.mjs.
# Nunca subir los valores reales al repositorio.

# Ghost Admin API (formato id:secret)
GHOST_ADMIN_KEY=

# Anthropic (generación de artículos)
ANTHROPIC_API_KEY=

# fal.ai (imágenes de respaldo)
FAL_API_KEY=

# TMDB (imágenes de Cinema / Anime / Culture)
TMDB_API_KEY=

# IGDB vía Twitch OAuth (imágenes de Games)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
