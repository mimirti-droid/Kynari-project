{{!< default}}
{{#is "paged"}}
<div style="padding-top: var(--nav-h);">
  <div class="archive-hero container">
    <span class="label">Archive</span>
    <h1 class="archive-hero__title">All articles</h1>
  </div>
  <section style="padding: 40px 0 80px;">
    <div class="container">
      <div class="featured__grid">
        {{#foreach posts}}{{> card-article}}{{/foreach}}
      </div>
      {{pagination}}
    </div>
  </section>
</div>
{{else}}

<!-- HERO EDITORIAL: el destacado más reciente (o el último artículo si no hay destacados) -->
{{#get "posts" filter="tag:featured" limit="1" include="tags,authors"}}
  {{#foreach posts}}{{> hero}}{{/foreach}}
{{else}}
  {{#get "posts" limit="1" include="tags,authors"}}{{#foreach posts}}{{> hero}}{{/foreach}}{{/get}}
{{/get}}

<!-- FEATURED (2.0.4): rejilla de revista, 1 grande + 4 (el primero destacado ya es el hero) -->
<section class="featured featured--grid" id="featured">
  <div class="container">
    <div class="section-header section-header--between">
      <h2 class="section-title">Featured</h2>
      <span class="section-sub">Editor's picks</span>
    </div>
    <div class="fgrid">
      {{#get "posts" filter="tag:featured" limit="6" include="tags"}}
        {{#foreach posts from="2" to="2"}}{{> card-feature big=true}}{{/foreach}}
        {{#foreach posts from="3" to="6"}}{{> card-feature}}{{/foreach}}
      {{else}}
        {{#get "posts" limit="6" include="tags"}}
          {{#foreach posts from="2" to="2"}}{{> card-feature big=true}}{{/foreach}}
          {{#foreach posts from="3" to="6"}}{{> card-feature}}{{/foreach}}
        {{/get}}
      {{/get}}
    </div>
  </div>
</section>

<!-- KYNARI LEGACY (v2.0.3: banda alta con los tres últimos ensayos) -->
<section class="legacy legacy--band">
  {{#get "posts" limit="1" filter="tag:legacy" include="tags"}}
    {{#foreach posts}}
    <div class="legacy__bg">
      {{#if feature_image}}<img src="{{img_url feature_image size="l" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}
    </div>
    {{/foreach}}
  {{/get}}
  <div class="container">
    <div class="legacy__content reveal">
      <h2 class="legacy__title">KYNARI LEGACY</h2>
      <p class="legacy__sub">Dive deeper into cinema, anime and visual culture with exclusive insights &amp; in-depth analyses</p>
    </div>
    {{#get "posts" limit="5" filter="tag:legacy" include="tags"}}
    {{#if posts}}
    <div class="legacy__grid" data-dedupe="3">
      {{#foreach posts}}
      <a href="{{url}}" class="legacy-card reveal" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
        <div class="legacy-card__img">
          {{#if feature_image}}<img src="{{img_url feature_image size="m" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}
          <span class="vb vb--nara legacy-card__nara" aria-hidden="true">Nara's take</span>
        </div>
        <div class="legacy-card__body">
          <span class="label">Legacy · {{reading_time}}</span>
          <h3 class="legacy-card__title">{{title}}</h3>
          {{#if excerpt}}<p class="legacy-card__excerpt">{{excerpt words="24"}}</p>{{/if}}
        </div>
      </a>
      {{/foreach}}
    </div>
    {{/if}}
    {{/get}}
    <div class="legacy__cta"><a href="{{@site.url}}/tag/legacy/" class="btn btn--outline">Enter Legacy</a></div>
  </div>
</section>

<!-- ENTER THE REALMS -->
<section class="realms" id="realms">
  <div class="container">
    <div class="realms__header reveal">
      <h2 class="realms__title">ENTER THE REALMS</h2>
      <p class="realms__sub">Choose your path. Every realm, a new perspective.</p>
    </div>
    <div class="realms__grid">
      <a href="{{@site.url}}/tag/cinema/" class="realm-card reveal">
        <div class="realm-card__bg"><img src="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_cinema.png" srcset="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_cinema.png 300w, {{@site.url}}/content/images/size/w600/format/webp/2026/09/realmfinal_cinema.png 600w" sizes="(max-width: 600px) 45vw, 218px" alt="Cinema" loading="lazy" decoding="async"></div>
        <div class="realm-card__overlay"></div>
        <div class="realm-card__body"><div class="realm-card__name label">Cinema</div><div class="realm-card__desc">Films, directors, aesthetics and visual storytelling.</div></div>
      </a>
      <a href="{{@site.url}}/tag/anime/" class="realm-card reveal">
        <div class="realm-card__bg"><img src="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_anime.png" srcset="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_anime.png 300w, {{@site.url}}/content/images/size/w600/format/webp/2026/09/realmfinal_anime.png 600w" sizes="(max-width: 600px) 45vw, 218px" alt="Anime" loading="lazy" decoding="async"></div>
        <div class="realm-card__overlay"></div>
        <div class="realm-card__body"><div class="realm-card__name label">Anime</div><div class="realm-card__desc">Series, movies, art and the world of anime.</div></div>
      </a>
      <a href="{{@site.url}}/tag/games/" class="realm-card reveal">
        <div class="realm-card__bg"><img src="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_games.png" srcset="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_games.png 300w, {{@site.url}}/content/images/size/w600/format/webp/2026/09/realmfinal_games.png 600w" sizes="(max-width: 600px) 45vw, 218px" alt="Games" loading="lazy" decoding="async"></div>
        <div class="realm-card__overlay"></div>
        <div class="realm-card__body"><div class="realm-card__name label">Games</div><div class="realm-card__desc">Game analysis, worlds and interactive storytelling.</div></div>
      </a>
      <a href="{{@site.url}}/tag/culture/" class="realm-card reveal">
        <div class="realm-card__bg"><img src="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_culture.png" srcset="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_culture.png 300w, {{@site.url}}/content/images/size/w600/format/webp/2026/09/realmfinal_culture.png 600w" sizes="(max-width: 600px) 45vw, 218px" alt="Culture" loading="lazy" decoding="async"></div>
        <div class="realm-card__overlay"></div>
        <div class="realm-card__body"><div class="realm-card__name label">Culture</div><div class="realm-card__desc">Ideas, movements and cultural phenomena.</div></div>
      </a>
      <a href="{{@site.url}}/tag/comic/" class="realm-card reveal">
        <div class="realm-card__bg"><img src="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_comic.png" srcset="{{@site.url}}/content/images/size/w300/format/webp/2026/09/realmfinal_comic.png 300w, {{@site.url}}/content/images/size/w600/format/webp/2026/09/realmfinal_comic.png 600w" sizes="(max-width: 600px) 45vw, 218px" alt="Comic" loading="lazy" decoding="async"></div>
        <div class="realm-card__overlay"></div>
        <div class="realm-card__body"><div class="realm-card__name label">Comic</div><div class="realm-card__desc">Western comics, manga and graphic narrative.</div></div>
      </a>
    </div>
  </div>
</section>

<!-- NARA'S TAKES: v2.js sustituye la imagen por el póster del vídeo de Nara y abre el reproductor -->
{{#get "posts" filter="tag:hash-nara" limit="8" include="tags"}}
{{#if posts}}
<section class="nara-row" id="nara">
  <div class="container">
    <div class="section-header section-header--between">
      <h2 class="section-title">Nara's Takes</h2>
      <span class="section-sub">The week's stories in sixty seconds — tap to watch</span>
    </div>
    <div class="nara-strip">
      {{#foreach posts}}
      <a href="{{url}}#nara" class="nara-card" data-nara-post="{{id}}">
        {{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}
        <div class="nara-card__top"><span class="badge-dur" hidden></span></div>
        <span class="nara-card__play" aria-hidden="true"></span>
        <div class="nara-card__body">
          {{#primary_tag}}<span class="nara-card__name">{{name}}</span>{{/primary_tag}}
          <div class="nara-card__title">{{title}}</div>
        </div>
      </a>
      {{/foreach}}
    </div>
  </div>
</section>
{{/if}}
{{/get}}

<!-- LATEST ARTICLES -->
<section class="latest">
  <div class="container">
    <div class="section-header section-header--between">
      <h2 class="section-title">Latest Articles</h2>
      <span class="section-sub">Five realms, every day</span>
    </div>
    {{#get "posts" filter="tag:-featured+tag:-signal" limit="7" include="tags,authors"}}
      <div class="latest__grid">
        {{#foreach posts limit="1"}}
        <a href="{{url}}" class="latest__hero-card reveal" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
          <div class="latest__hero-image">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="m" format="webp"}}" srcset="{{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 600w" sizes="(max-width: 900px) 90vw, 560px" alt="{{title}}" loading="lazy" decoding="async">
            {{else}}<div class="card-ph"></div>{{/if}}
            <div class="vbadges" aria-hidden="true"><span class="vb vb--nara">Nara's take</span><span class="vb vb--trailer">▶ Trailer</span><span class="vb vb--gameplay">▶ Gameplay</span></div>
          </div>
          <span class="label latest__hero-cat">{{#primary_tag}}{{name}} · {{/primary_tag}}<time datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date timeago="true"}}</time></span>
          <h3 class="latest__hero-title">{{title}}</h3>
          {{#if excerpt}}<p class="latest__hero-excerpt">{{excerpt words="40"}}</p>{{/if}}
          <span class="byline">{{#primary_author}}{{#if profile_image}}<img class="byline__av" src="{{img_url profile_image size="xs"}}" alt="" loading="lazy">{{/if}}By {{name}}{{/primary_author}}</span>
        </a>
        {{/foreach}}
        <ul class="latest__list reveal">
          {{#foreach posts from="2"}}
          <li>
            <a href="{{url}}" class="list-item" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
              <div class="list-item__image">
                {{#if feature_image}}<img src="{{img_url feature_image size="xs" format="webp"}}" srcset="{{img_url feature_image size="xs" format="webp"}} 150w, {{img_url feature_image size="s" format="webp"}} 300w" sizes="96px" alt="" loading="lazy" decoding="async">{{else}}<div class="card-ph"></div>{{/if}}
              </div>
              <div class="list-item__body">
                <span class="label list-item__cat">{{#primary_tag}}{{name}} · {{/primary_tag}}<time datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date timeago="true"}}</time><span class="vb-text vb-text--video"> · ▶</span></span>
                <h3 class="list-item__title">{{title}}</h3>
                {{#if excerpt}}<p class="card-excerpt">{{excerpt words="18"}}</p>{{/if}}
              </div>
            </a>
          </li>
          {{/foreach}}
        </ul>
      </div>
    {{/get}}
    <p class="latest__more"><a href="{{@site.url}}/page/2/" class="btn btn--outline">More articles</a></p>
  </div>
</section>

<!-- WATCH (2.1): On Screen y Signal en una sola fila. Arriba, tráileres y gameplay de los
     artículos (1 grande + 4); debajo, lo último de Signal. Sin repetidos con lo de más arriba (v2.js). -->
<section class="watch-row" id="watch" data-screen-dedupe>
  <div class="container">
    <div class="section-header section-header--between">
      <h2 class="section-title">Watch<span class="live-dot" hidden aria-label="New in the last hours"></span></h2>
      <a class="section-sub" href="{{@site.url}}/watch/">Official trailers, gameplay and Nara's takes →</a>
    </div>
    {{#get "posts" filter="tag:hash-video+tag:-signal" limit="12" include="tags"}}
    {{#if posts}}
    <div class="screen__grid">
      {{#foreach posts limit="1"}}
      <a href="{{url}}#watch" class="video-tile video-tile--big" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
        {{#if feature_image}}<img src="{{img_url feature_image size="l" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}
        <div class="vbadges vbadges--tile" aria-hidden="true"><span class="vb vb--trailer">Official trailer</span><span class="vb vb--gameplay">Gameplay</span><span class="vb vb--nara">Nara's take</span></div>
        <span class="nara-card__play" aria-hidden="true"></span>
        <div class="video-tile__body">
          <div class="video-tile__title">{{title}}</div>
          <div class="video-tile__meta">{{#primary_tag}}<span class="realm-tag">{{name}}</span> · {{/primary_tag}}{{date format="DD MMM"}}</div>
        </div>
      </a>
      {{/foreach}}
      <div class="video-list" data-dedupe="4">
        {{#foreach posts from="2"}}
        <a href="{{url}}#watch" class="video-row" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
          <div class="thumb">{{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}<span class="nara-card__play nara-card__play--sm" aria-hidden="true"></span></div>
          <div>
            <span class="label">{{#primary_tag}}{{name}}{{/primary_tag}}<span class="vb-text vb-text--trailer"> · Trailer</span><span class="vb-text vb-text--gameplay"> · Gameplay</span></span>
            <h3 class="video-row__title">{{title}}</h3>
          </div>
        </a>
        {{/foreach}}
      </div>
    </div>
    {{/if}}
    {{/get}}

    {{#get "posts" filter="tag:signal" limit="6" include="tags"}}
    {{#if posts}}
    <div class="watch-row__sub">
      <span class="watch-row__kicker">Signal · just in</span>
      <a class="section-sub" href="{{@site.url}}/tag/signal/">Trailers &amp; short takes, as they land →</a>
    </div>
    <div class="signal-strip">
      {{#foreach posts}}
      <a href="{{url}}" class="signal-item" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
        <div class="signal-item__thumb">
          {{#if feature_image}}<img src="{{img_url feature_image size="s" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}
          <span class="nara-card__play" aria-hidden="true"></span>
        </div>
        <div class="signal-item__body">
          <span class="label">{{#primary_tag}}{{name}} · {{/primary_tag}}<time datetime="{{date format="YYYY-MM-DDTHH:mm"}}">{{date timeago="true"}}</time></span>
          <h3>{{title}}</h3>
        </div>
      </a>
      {{/foreach}}
    </div>
    {{/if}}
    {{/get}}
  </div>
</section>

{{> newsletter}}
{{/is}}
