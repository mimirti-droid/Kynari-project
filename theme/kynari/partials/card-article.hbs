{{!-- Tarjeta de rejilla (archivo, realm, more like this). --}}
<a href="{{url}}" class="article-card reveal" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
  <div class="article-card__image">
    {{#if feature_image}}
      <img src="{{img_url feature_image size="s" format="webp"}}" srcset="{{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 600w" sizes="(max-width: 600px) 90vw, 300px" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy" decoding="async">
    {{else}}
      <div class="card-ph"></div>
    {{/if}}
  </div>
  <div class="article-card__overlay"></div>
  <div class="vbadges" aria-hidden="true">
    <span class="vb vb--nara">Nara's take</span>
    <span class="vb vb--trailer">▶ Trailer</span>
    <span class="vb vb--gameplay">▶ Gameplay</span>
  </div>
  <div class="article-card__body">
    {{#primary_tag}}<span class="article-card__cat label">{{name}}</span>{{/primary_tag}}
    <h2 class="article-card__title">{{title}}</h2>
    <div class="article-card__meta"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time> · {{reading_time minute="1 min" minutes="% min"}}</div>
  </div>
</a>
