{{!-- Hero editorial: el artículo del día sobre su imagen. Si el post lleva #loop, v2.js
     sustituye la imagen por el bucle mudo (solo escritorio, conexión rápida, sin reduce-motion).
     Si lleva #nara, v2.js añade la tarjeta vertical de Nara a la derecha. --}}
<section class="hero-v2" data-post-id="{{id}}" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
  <div class="hero-v2__media">
    {{#if feature_image}}
      <img src="{{img_url feature_image size="l" format="webp"}}" srcset="{{img_url feature_image size="m" format="webp"}} 600w, {{img_url feature_image size="l" format="webp"}} 1000w, {{img_url feature_image size="xl" format="webp"}} 2000w" sizes="100vw" alt="" fetchpriority="high" decoding="async">
    {{/if}}
  </div>
  <div class="hero-v2__grain" aria-hidden="true"></div>
  <div class="hero-v2__inner">
    <div class="hero-v2__text">
      <div class="hero-v2__kicker">
        {{#primary_tag}}<span class="label">{{name}}</span>{{/primary_tag}}
        <span class="pill pill--nara" hidden></span>
      </div>
      <h1 class="hero-v2__title"><a href="{{url}}">{{title}}</a></h1>
      {{#if custom_excerpt}}<p class="hero-v2__dek">{{custom_excerpt}}</p>{{/if}}
      <div class="hero-v2__meta">
        <span>By {{primary_author.name}}</span><span>·</span>
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time><span>·</span>
        <span>{{reading_time}}</span>
      </div>
      <div class="hero-v2__ctas">
        <a href="{{url}}" class="btn btn--gold">Read the analysis</a>
        <button type="button" class="btn btn--outline btn--video" data-hero-watch hidden><i aria-hidden="true">▶</i> <span>Watch</span></button>
      </div>
    </div>
    <div class="hero-v2__side" data-hero-side></div>
  </div>
</section>
