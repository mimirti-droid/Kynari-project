{{!< default}}

{{#post}}
<article class="article-v2" data-post-id="{{id}}" data-tags="{{#foreach tags visibility="all"}}{{slug}} {{/foreach}}">
  <header class="article-header container">
    {{#primary_tag}}
      <a href="{{url}}" class="label article-header__cat">{{name}}</a>
    {{/primary_tag}}
    <h1 class="article-header__title">{{title}}</h1>
    {{#if custom_excerpt}}
      <p class="article-header__subtitle">{{custom_excerpt}}</p>
    {{/if}}
    <div class="article-header__meta">
      <span>By <a href="{{primary_author.url}}" class="article-header__author">{{primary_author.name}}</a></span>
      <span>·</span>
      <span><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></span>
      <span>·</span>
      <span>{{reading_time}}</span>
      <span class="meta-watch" hidden>·</span>
      <a href="#watch" class="meta-watch meta-watch__link" hidden>▶ Watch</a>
    </div>
  </header>

  {{#if feature_image}}
  <figure class="article-feature-image">
    <img src="{{img_url feature_image size="l" format="webp"}}" srcset="{{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 600w, {{img_url feature_image size="l" format="webp"}} 1000w, {{img_url feature_image size="xl" format="webp"}} 2000w" sizes="100vw" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" fetchpriority="high">
    {{#if feature_image_caption}}<figcaption class="article-feature-image__caption">{{feature_image_caption}}</figcaption>{{/if}}
  </figure>
  {{/if}}

  <div class="article-grid">
    <aside class="rail" aria-label="Share">
      <a class="rail__btn" href="https://x.com/intent/post?url={{url absolute="true"}}&amp;text={{encode title}}" target="_blank" rel="noopener" aria-label="Share on X">X</a>
      <a class="rail__btn" href="https://www.threads.net/intent/post?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener" aria-label="Share on Threads">Thr</a>
      <a class="rail__btn" href="https://bsky.app/intent/compose?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener" aria-label="Share on Bluesky">Bsky</a>
      <a class="rail__btn" href="https://wa.me/?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">WA</a>
      <button class="rail__btn" type="button" data-share-copy="{{url absolute="true"}}" aria-label="Copy link">Link</button>
    </aside>

    <div class="article-main">
      <div class="article-body">
        {{content}}
      </div>

      {{#if tags}}
      <nav class="tags-end" aria-label="Topics">
        {{#foreach tags}}<a href="{{url}}">{{name}}</a>{{/foreach}}
      </nav>
      {{/if}}

      <div class="article-after">
        <div class="share" aria-label="Share this article">
          <span class="label share__label">Share</span>
          <a class="share__btn" href="https://x.com/intent/post?url={{url absolute="true"}}&amp;text={{encode title}}" target="_blank" rel="noopener">X</a>
          <a class="share__btn" href="https://www.threads.net/intent/post?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener">Threads</a>
          <a class="share__btn" href="https://bsky.app/intent/compose?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener">Bluesky</a>
          <a class="share__btn" href="https://wa.me/?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener">WhatsApp</a>
          <button class="share__btn" type="button" data-share-copy="{{url absolute="true"}}">Copy link</button>
          <button class="share__btn share__native" type="button" data-share-native data-title="{{title}}" data-url="{{url absolute="true"}}" hidden>Share…</button>
        </div>

        {{#primary_author}}
        <aside class="author-box">
          {{#if profile_image}}<img class="author-box__img" src="{{img_url profile_image size="xs" format="webp"}}" alt="" width="64" height="64" loading="lazy">{{/if}}
          <div>
            <a href="{{url}}" class="author-box__name">{{name}}</a>
            {{#if bio}}<p class="author-box__bio">{{bio}}</p>{{/if}}
          </div>
        </aside>
        {{/primary_author}}
      </div>
    </div>

    <aside class="aside">
      <div class="aside__nara" data-nara-aside hidden></div>
      {{#get "posts" filter="id:-{{id}}+tag:-signal" limit="4" include="tags"}}
      <div>
        <span class="aside__label">Latest on Kynari</span>
        <div class="aside__list">
          {{#foreach posts}}
          <a href="{{url}}" class="aside__item">
            <div class="thumb">{{#if feature_image}}<img src="{{img_url feature_image size="xs" format="webp"}}" alt="" loading="lazy" decoding="async">{{/if}}</div>
            <div><span class="label">{{#primary_tag}}{{name}}{{/primary_tag}}</span><h5>{{title}}</h5></div>
          </a>
          {{/foreach}}
        </div>
      </div>
      {{/get}}
    </aside>
  </div>

  {{!-- Formulario de newsletter que v2.js mueve a mitad del texto --}}
  <template id="inline-newsletter">
    {{> newsletter inline=true}}
  </template>

  {{#if primary_tag}}
    {{#get "posts" filter="tag:{{primary_tag.slug}}+id:-{{id}}+tag:-signal" limit="3" include="tags"}}
    {{#if posts}}
    <div class="container readnext">
      <div class="section-header">
        <h2 class="section-title">More Like This</h2>
      </div>
      <div class="featured__grid">
        {{#foreach posts}}{{> card-article}}{{/foreach}}
      </div>
    </div>
    {{/if}}
    {{/get}}
  {{/if}}
</article>

{{!-- Barra fija en móvil con el take de Nara (la rellena v2.js) --}}
<div class="sticky-watch" data-sticky-watch hidden></div>
{{/post}}
