{{!< default}}

<div style="padding-top: var(--nav-h);">
  {{#author}}
  <div class="author-hero">
    <div class="container">
      {{#if profile_image}}
        <img class="author-hero__img" src="{{img_url profile_image size="s" format="webp"}}" alt="{{name}}" width="120" height="120">
      {{/if}}
      <span class="label" style="display:block;margin-bottom:12px;letter-spacing:0.3em;">Author</span>
      <h1 class="author-hero__name">{{name}}</h1>
      {{#if bio}}<p class="author-hero__bio">{{bio}}</p>{{/if}}
      <p class="author-hero__links">
        {{#if website}}<a href="{{website}}" target="_blank" rel="noopener">Website</a>{{/if}}
        {{#if twitter}}<a href="{{social_url type="twitter"}}" target="_blank" rel="noopener">X</a>{{/if}}
        <a href="{{@site.url}}/about/">About Kynari</a>
      </p>
    </div>
  </div>
  {{/author}}

  <section style="padding: 60px 0 80px;">
    <div class="container">
      <div class="featured__grid">
        {{#foreach posts}}
        <a href="{{url}}" class="article-card reveal">
          <div class="article-card__image">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s" format="webp"}}" srcset="{{img_url feature_image size="xs" format="webp"}} 150w, {{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 600w" sizes="(max-width: 600px) 90vw, 300px" alt="{{title}}" loading="lazy">
            {{else}}
              <div style="height:100%;background:var(--surface-3);"></div>
            {{/if}}
          </div>
          <div class="article-card__overlay"></div>
          <div class="article-card__body">
            {{#primary_tag}}<span class="article-card__cat label">{{name}}</span>{{/primary_tag}}
            <h2 class="article-card__title">{{title}}</h2>
            <div class="article-card__meta">{{date format="DD MMM YYYY"}}</div>
          </div>
        </a>
        {{/foreach}}
      </div>
      {{pagination}}
    </div>
  </section>
</div>
