{{!< default}}

<div style="padding-top: var(--nav-h);">

  <!-- Category Hero -->
  <div style="padding: 80px 0 60px; text-align:center; background: radial-gradient(ellipse 80% 60% at 50% 40%, #0e0e1f 0%, #080808 70%); border-bottom: 1px solid rgba(184,152,106,0.12);">
    <div class="container">

      <!-- Logo: CSS (not a custom helper) decides which one shows, based on the
           "tag-{slug}" class Ghost already adds to <body> via {{body_class}}. -->
      {{#if @site.logo}}
        <img src="{{@site.logo}}" alt="Kynari Legacy" class="tag-hero-logo tag-hero-logo--legacy" style="width:90px;height:90px;object-fit:contain;margin:0 auto 28px;display:none;opacity:0.9;">
        <img src="{{@site.logo}}" alt="{{@site.title}}" class="tag-hero-logo tag-hero-logo--default" style="width:70px;height:70px;object-fit:contain;margin:0 auto 24px;display:block;opacity:0.8;">
      {{/if}}

      <span class="label" style="display:block;margin-bottom:16px;letter-spacing:0.3em;">Realm</span>
      <h1 style="font-family:var(--font-display);font-size:clamp(40px,7vw,80px);letter-spacing:0.25em;color:var(--white);margin-bottom:20px;">{{tag.name}}</h1>
      {{#if tag.description}}
        <p style="font-family:var(--font-body);font-size:19px;color:var(--grey-light);font-style:italic;max-width:500px;margin:0 auto;line-height:1.6;">{{tag.description}}</p>
      {{/if}}

    </div>
  </div>

  <!-- Articles grid -->
  <section style="padding: 80px 0;">
    <div class="container">
      <div class="featured__grid">
        {{#foreach posts}}
        <a href="{{url}}" class="article-card reveal">
          <div class="article-card__image">
            {{#if feature_image}}
              <img src="{{img_url feature_image size="s" format="webp"}}" srcset="{{img_url feature_image size="xs" format="webp"}} 150w, {{img_url feature_image size="s" format="webp"}} 300w, {{img_url feature_image size="m" format="webp"}} 600w" sizes="(max-width: 600px) 90vw, 300px" alt="{{title}}" loading="lazy">
            {{else}}
              <div style="height:100%;background:var(--surface-3);"></div>
            {{/if}}
          </div>
          <div class="article-card__overlay"></div>
          <div class="article-card__body">
            {{#primary_tag}}
              <span class="article-card__cat label">{{name}}</span>
            {{/primary_tag}}
            <h2 class="article-card__title">{{title}}</h2>
            <div class="article-card__meta">{{date format="DD MMM YYYY"}}</div>
          </div>
        </a>
        {{/foreach}}
      </div>

      {{pagination}}
    </div>
  </section>
</div>
